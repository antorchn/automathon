# ==============================================================================
# Configuration de l'Arène Automathon en ligne (V0 — vr-4v-4g par défaut)
# Copier vers `.env` et renseigner les secrets avant le démarrage.
# NE JAMAIS COMMITER `.env`.
# ==============================================================================

# --- Réseau, proxy et secrets ---
# URL publique complète (ex: https://exemple.fr/arene ou https://arene.exemple.fr)
PUBLIC_URL=http://localhost:8001/arene
# Sous-chemin derrière le reverse proxy ('/arene' ou '/' pour un sous-domaine)
ARENE_BASE_PATH=/arene
# Port local sur la VM (publié uniquement sur 127.0.0.1)
ARENE_PORT=8001
# Proxys dont l'arène croit les en-têtes X-Forwarded-* (adresses ou réseaux, séparés par des virgules).
# Le site voit Caddy et le tunnel SSH par la passerelle du réseau Docker (172.x.0.1), d'où 172.16.0.0/12.
# Derrière le site de l'association, ajouter l'IP de son reverse proxy (scripts/configure_public.sh le fait).
TRUSTED_PROXY=127.0.0.1,172.16.0.0/12

# Clé secrète longue et aléatoire (ex: `openssl rand -hex 32`)
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
# Jeton partagé entre le site et les workers (ex: `openssl rand -hex 32`)
WORKER_TOKEN=CHANGE_ME_GENERATE_RANDOM_WORKER_TOKEN

# OAuth GitHub (laisser vide uniquement si AUTH_DEV_MODE=true en local HTTP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Connexion de test sans GitHub (refusé automatiquement au démarrage si PUBLIC_URL est en HTTPS).
# Mettre true pendant les tests par tunnel SSH, tant que l'OAuth App GitHub n'existe pas.
AUTH_DEV_MODE=false
# Logins GitHub des administrateurs, séparés par des virgules
ADMIN_GITHUB_LOGINS=

# --- Stockage ---
DATABASE_URL=sqlite:////data/arene.db
DATA_DIR=/data

# --- Worker (les 4 variables de la spec + URL interne Compose) ---
# Sur la VM de l'arène, le worker appelle arene-web par le réseau interne Compose, sous ARENE_BASE_PATH :
# laisser SITE_URL commenté. Seul un worker sur une autre machine le règle, sur l'adresse publique de l'arène.
# SITE_URL=https://exemple.fr/arene
WORKER_PARALLEL_MATCHES=2
WORKER_NICE=10

# --- Paramètres V0 (vr-4v-4g) ---
PLACEMENT_OPPONENTS=5
PLACEMENT_MAPS_PER_OPPONENT=10
VALIDATION_GAMES=2
BACKGROUND_ENABLED=true
BACKGROUND_MAPS_PER_JOB=1
BACKGROUND_DUTY=50
BACKGROUND_TARGET_MARGIN=50
MAX_GAMES_PER_PAIR=100
MAX_PLACEMENTS_IN_PROGRESS=1

DECISION_MEAN_MS_LIMIT=5.0
DECISION_TIMEOUT_MS=500
MAX_EXCEPTIONS_PER_GAME=50
AGENT_LOAD_TIMEOUT_S=60
AGENT_MEMORY_MB=768
MAX_FRAMES=4200

SUBMISSION_MAX_MB=50
COOLDOWN_MINUTES=30
QUEUE_MAX=20
JOB_LEASE_SECONDS=600
PROVISIONAL_MARGIN=75
ANCHOR_AGENT_NAME=rush_bot
ANCHOR_ELO=1000
REPLAYS_KEPT_PER_PAIR=2
REPLAY_RETENTION_DAYS=14
ACCOUNTS_PER_IP_PER_DAY=3
GAME_VERSION=1.0.0
